{
  "expo": {
    "name": "OpenBot",
    "slug": "openbot",
    "scheme": "openbot",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leka74.openbot"
    },
    "android": {
      "package": "com.leka74.openbot"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OpenBot uses the camera to scan the code that connects the app to your OpenBot."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OpenBot lets you send photos to your Bots."
        }
      ]
    ]
  }
}
